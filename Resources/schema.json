{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LevelGenerationOverride",
  "type": "object",
  "properties": {
    "LevelLayoutID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ZoneOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZoneOverride"
      },
      "default": []
    },
    "GeoOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GeoOverride"
      },
      "default": []
    },
    "ExtraComplexResourceToLoad": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Complex"
      },
      "default": []
    }
  },
  "required": [
    "LevelLayoutID",
    "ZoneOverrides",
    "GeoOverrides",
    "ExtraComplexResourceToLoad"
  ],
  "additionalProperties": false,

  "$defs": {
    "ZoneOverride": {
      "type": "object",
      "properties": {
        "AreaOverrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AreaOverride"
          },
          "default": []
        }
      },
      "required": [
        "AreaOverrides"
      ],
      "additionalProperties": false
    },

    "AreaOverride": {
      "type": "object",
      "properties": {
        "PreviousCellPosition": {
          "$ref": "#/$defs/LG_GridPosition"
        },
        "PreviousCellInternalAreaID": {
          "type": "integer"
        },
        "LG_ExpanderID": {
          "type": "integer"
        }
      },
      "required": [
        "PreviousCellPosition",
        "PreviousCellInternalAreaID",
        "LG_ExpanderID"
      ],
      "additionalProperties": false
    },

    "GeoOverride": {
      "type": "object",
      "properties": {
        "Position": {
          "$ref": "#/$defs/LG_GridPosition"
        },
        "Geomorph": {
          "type": "string"
        },
        "Rotation": {
          "type": "number"
        }
      },
      "required": [
        "Position",
        "Geomorph",
        "Rotation"
      ],
      "additionalProperties": false
    },

    "LG_GridPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false
    },

    "Complex": {
      "type": "string",
      "enum": [
        "Mining",
        "Service",
        "Tech"
      ]
    }
  }
}
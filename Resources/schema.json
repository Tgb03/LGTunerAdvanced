{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LevelGenerationOverride",
  "type": "object",
  "properties": {
    "ExtraComplexResourceToLoad": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Complex"
      }
    },
    "GeoOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GeoOverride"
      }
    },
    "LevelLayoutID": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ZoneOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZoneOverride"
      }
    }
  },
  "required": [
    "LevelLayoutID",
    "ZoneOverrides",
    "GeoOverrides",
    "ExtraComplexResourceToLoad"
  ],
  "$defs": {
    "AreaOverride": {
      "type": "object",
      "properties": {
        "LG_ExpanderID": {
          "type": "integer",
          "format": "int32"
        },
        "PreviousCellInternalAreaID": {
          "type": "integer",
          "format": "int32"
        },
        "PreviousCellPosition": {
          "$ref": "#/$defs/LGGridPosition"
        }
      },
      "required": [
        "PreviousCellPosition",
        "PreviousCellInternalAreaID",
        "LG_ExpanderID"
      ]
    },
    "Complex": {
      "type": "string",
      "enum": [
        "Mining",
        "Service",
        "Tech"
      ]
    },
    "GeoOverride": {
      "type": "object",
      "properties": {
        "Altitude": {
          "type": "integer",
          "format": "int32"
        },
        "Geomorph": {
          "type": "string"
        },
        "Position": {
          "$ref": "#/$defs/LGGridPosition"
        },
        "Rotation": {
          "$ref": "#/$defs/GeoRotation"
        },
        "NorthPlug": {
          "type": "string"
        },
        "EastPlug": {
          "type": "string"
        },
        "SouthPlug": {
          "type": "string"
        },
        "WestPlug": {
          "type": "string"
        }
      },
      "required": [
        "Position",
        "Geomorph",
        "Rotation",
        "Altitude"
      ]
    },
    "GeoRotation": {
      "type": "string",
      "enum": [
        "Forwards",
        "Right",
        "Backwards",
        "Left"
      ]
    },
    "LGGridPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "z"
      ]
    },
    "ZoneOverride": {
      "type": "object",
      "properties": {
        "AreaOverrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AreaOverride"
          }
        }
      },
      "required": [
        "AreaOverrides"
      ]
    }
  }
}
